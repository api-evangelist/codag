          "id": "3cf8f50c-7703-4826-9e41-16101910dcdf",
          "name": "Get Onboard Sources",
          "request": {
            "name": "Get Onboard Sources",
            "description": {
              "content": "Return per-source warm history for a specific org the caller belongs to.\n\nThe dashboard pairs this with its hardcoded source catalog to show\n'Last warmed: 2h ago, +127 templates' next to each integration tile.\n\nPrefer `?org_id=<numeric>`. `?slug=<org-slug>` is accepted as a\none-release deprecation path (resolved against the caller's\nmemberships, 409 `slug_ambiguous` on collision). Without either, we\nreturn an empty list rather than guessing — guessing leaks data when\na user belongs to multiple orgs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "onboard",
                "sources"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "org_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "slug",
                  "value": "<string>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
