          "id": "e83f399c-10e1-4085-9f3d-97509ef6f522",
          "name": "Warm Endpoint",
          "request": {
            "name": "Warm Endpoint",
            "description": {
              "content": "Bulk pre-warm template_cache from historical user logs.\n\nReuses pipeline.parse() so persistence (template_cache + incident_families)\nhappens through the same ON CONFLICT DO UPDATE path as live /v1/compact\ncalls. Idempotent across re-runs. Daily per-org line quota guards against\nrunaway LLM cost on a misconfigured client.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "onboard",
                "warm"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"source\": \"unknown\"\n}",
