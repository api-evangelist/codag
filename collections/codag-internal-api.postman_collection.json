          "name": "Internal Notifications Run",
          "request": {
            "name": "Internal Notifications Run",
            "description": {
              "content": "Secret-gated trigger for the email engine (spike alerts + weekly digest).\nWire a daily cron to POST here with `X-Cron-Secret`. `dry_run` defaults True\n(computes and returns what it *would* send, emails nobody).",
              "type": "text/plain"
            },
