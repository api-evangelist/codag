          "name": "Google Login",
          "request": {
            "name": "Google Login",
            "description": {
              "content": "Exchange a Google authorization code for a session JWT + user/org info.\n\nSignup is open: any Google account can sign in. A first-time user with an\norg invite token joins that org; otherwise they land with no org and the\nconsole prompts them to create their first org via `POST /api/orgs/self-serve`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "google"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
